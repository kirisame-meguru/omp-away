<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded question notification. RemoteViews only: no editable views; text arrives through RemoteInput actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView
        android:id="@+id/form_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
    <TextView
        android:id="@+id/form_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@android:style/TextAppearance.Material.Notification" />
    <TextView
        android:id="@+id/form_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
    <LinearLayout
        android:id="@+id/form_options"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
    <TextView
        android:id="@+id/form_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingTop="4dp"
        android:textAppearance="@android:style/TextAppearance.Material.Notification" />
    <TextView
        android:id="@+id/form_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingTop="4dp"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Info" />
    <LinearLayout
        android:id="@+id/form_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/form_previous"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:paddingEnd="12dp"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
        <TextView
            android:id="@+id/form_page"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:textAppearance="@android:style/TextAppearance.Material.Notification" />
        <TextView
            android:id="@+id/form_next"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
        <TextView
            android:id="@+id/form_voice"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical|end"
            android:maxLines="1"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
    </LinearLayout>
</LinearLayout>
